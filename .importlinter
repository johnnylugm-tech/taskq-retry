[importlinter]
root_package = taskq_api
include_external_packages = True

[importlinter:contract:layers-api-service-repository-models]
name = Layered architecture
type = layers
layers =
    taskq_api.api
    taskq_api.service
    taskq_api.repository
    taskq_api.models

[importlinter:contract:independence-config-errors]
name = Config and errors are independent leaves
type = independence
modules =
    taskq_api.config
    taskq_api.errors

[importlinter:contract:forbid-sqlalchemy-outside-repository]
name = SQLAlchemy only in repository and models
type = forbidden
source_modules =
    taskq_api.api
    taskq_api.service
    taskq_api.errors
    taskq_api.config
    taskq_api.app
    taskq_api.__main__
forbidden_modules =
    sqlalchemy
allow_indirect_imports = True
