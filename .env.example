# taskq-api environment variables (SPEC.md section 5.1). Copy to .env and adjust.

# Database URL. Must never appear in logs, errors or /v1/metrics (NFR-04).
TASKQ_DB_URL=sqlite:///./taskq.db
# SQLAlchemy connection pool size (FR-06).
TASKQ_DB_POOL_SIZE=5
# Per-task subprocess timeout in seconds.
TASKQ_TASK_TIMEOUT=10.0
# Maximum concurrent background runs (FR-08).
TASKQ_MAX_CONCURRENT=8
# Seconds to wait for in-flight runs on shutdown before marking them interrupted.
TASKQ_DRAIN_TIMEOUT=30.0
# Token bucket capacity (FR-05).
TASKQ_RATE_BURST=20
# Token bucket refill rate per second (FR-05).
TASKQ_RATE_PER_SEC=5.0
# Comma-separated allowed CORS origins; empty denies all (NFR-02).
TASKQ_CORS_ORIGINS=
# DEBUG / INFO / WARNING / ERROR.
TASKQ_LOG_LEVEL=INFO
# json / text.
TASKQ_LOG_FORMAT=json
# Listen address; the default is not exposed externally.
TASKQ_HOST=127.0.0.1
# Listen port.
TASKQ_PORT=8000
